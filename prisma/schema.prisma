// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role-based user system
enum Role {
  STUDENT
  TUTOR
  ADMIN
}

// Minimal User model - authentication only
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  password           String    // Hashed with bcrypt
  role               Role
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Profile tracking fields for rate limiting and statistics
  lastEmailChange    DateTime?
  lastPasswordChange DateTime?
  lastLoginAt        DateTime?

  // One-to-one profiles based on role
  tutorProfile   TutorProfile?
  studentProfile StudentProfile?
}

// Tutor-specific profile and relations
model TutorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only tutors have these relations
  students           TutorStudent[]  @relation("TutorStudents")
  assignmentsCreated Assignment[]
  questionsCreated   Question[]
}

// Student-specific profile and relations
model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only students have these relations
  tutors              TutorStudent[]    @relation("StudentTutors")
  assignmentsAssigned Assignment[]
  answers             StudentAnswer[]
}

// Join table for many-to-many tutor-student relationship
model TutorStudent {
  id              String   @id @default(cuid())
  tutorProfileId  String
  studentProfileId String
  createdAt       DateTime @default(now())

  tutorProfile   TutorProfile   @relation("TutorStudents", fields: [tutorProfileId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation("StudentTutors", fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, studentProfileId])
  @@index([tutorProfileId])
  @@index([studentProfileId])
}

// Subjects: Mathematics, Polish, English
model Subject {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  categories Category[]
  questions  Question[]
}

// Categories within each subject (e.g., Math has 13 categories)
model Category {
  id        String @id @default(cuid())
  name      String
  slug      String
  order     Int    // For ordering categories
  subjectId String

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, slug])
}

// Questions (currently closed-ended only)
model Question {
  id                String   @id @default(cuid())
  text              String   // Question text with LaTeX support
  subjectId         String
  categoryId        String
  createdByProfileId String?  // Optional: track which tutor created the question
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subject         Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy       TutorProfile?      @relation(fields: [createdByProfileId], references: [id], onDelete: SetNull)
  answerOptions   AnswerOption[]
  assignmentItems AssignmentItem[]
  studentAnswers  StudentAnswer[]
}

// Answer options for closed-ended questions
model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  // Answer text with LaTeX support
  isCorrect  Boolean @default(false)
  order      Int     // For ordering answer options

  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]
}

// Assignment: A set of questions assigned to a student by a tutor
model Assignment {
  id                 String    @id @default(cuid())
  title              String
  creatorProfileId   String    // Tutor profile who created the assignment
  assignedToProfileId String   // Student profile assigned to the assignment
  dueDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creator    TutorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  assignedTo StudentProfile   @relation(fields: [assignedToProfileId], references: [id], onDelete: Cascade)
  items      AssignmentItem[]
}

// Questions included in an assignment
model AssignmentItem {
  id           String @id @default(cuid())
  assignmentId String
  questionId   String
  order        Int    // Order of question in assignment

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
}

// Student answers to track progress and errors
model StudentAnswer {
  id               String   @id @default(cuid())
  studentProfileId String   // References StudentProfile
  questionId       String
  answerOptionId   String?  // Selected answer (null if not answered yet)
  isCorrect        Boolean? // Null if not answered, true/false if answered
  attemptedAt      DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerOption   AnswerOption?  @relation(fields: [answerOptionId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, questionId])
}
